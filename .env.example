# URL base de la API (sin trailing slash). SIEMPRE same-origin: la sesión es una cookie
# HttpOnly (`mec3d_session`) que debe ser first-party.
# - Development: el proxy de Vite (vite.config.ts) reenvía /api -> http://localhost:3000
# - Production: el rewrite de vercel.json reenvía /api -> https://mec3d-api.onrender.com
VITE_API_URL=/api/v1

# Origen del backend para Socket.IO (conexión directa: Vercel no proxea WebSockets).
# El handshake se autentica con un token de 60 s pedido a POST /auth/socket-token.
# Si se omite: origen de VITE_API_URL cuando es absoluta; con API relativa,
# http://localhost:3000 en dev. En producción: https://mec3d-api.onrender.com
VITE_SOCKET_URL=http://localhost:3000
